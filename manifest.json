{
   "manifest_version": 3,
   "name": "FB Comment Scraper (BTL)",
   "description": "Cào bài viết và bình luận Facebook phục vụ nghiên cứu khai phá dữ liệu văn bản. Dữ liệu chỉ lưu trên máy.",
   "version": "1.26.0",
   "version_name": "1.26.0 scraper-only, go code ben thu ba",
   "action": {
      "default_title": "Mở FB Comment Scraper",
      "default_icon": {
         "16": "assets/icon.png",
         "48": "assets/icon.png",
         "128": "assets/icon.png"
      }
   },
   "icons": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "js": ["lib/scraper-core.js", "content.js"],
         "matches": ["*://facebook.com/*", "*://*.facebook.com/*"],
         "run_at": "document_idle"
      }
   ],
   "permissions": ["storage", "tabs", "scripting"],
   "host_permissions": ["*://facebook.com/*", "*://*.facebook.com/*"],
   "web_accessible_resources": [
      {
         "matches": ["*://facebook.com/*", "*://*.facebook.com/*"],
         "resources": ["domselector.config.json"]
      }
   ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self';"
   },
   "options_ui": {
      "page": "scraper.html",
      "open_in_tab": true
   }
}
